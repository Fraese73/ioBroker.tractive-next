{
  "common": {
    "name": "tractive-next",
    "version": "0.2.0",
    "titleLang": {
      "en": "Tractive Next",
      "de": "Tractive Next"
    },
    "desc": {
      "en": "Unofficial Tractive GPS integration with automatic state discovery.",
      "de": "Inoffizielle Tractive-GPS-Integration mit automatischer Datenpunkterkennung."
    },
    "authors": [
      "Michael Fraessdorf"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "compact": true,
    "enabled": true,
    "icon": "tractive-next.png",
    "extIcon": "https://raw.githubusercontent.com/Fraese73/ioBroker.tractive-next/main/admin/tractive-next.png",
    "type": "geoposition",
    "connectionType": "cloud",
    "dataSource": "poll",
    "materialize": true,
    "adminUI": {
      "config": "json",
      "tab": "materialize"
    },
    "adminTab": {
      "singleton": true,
      "name": {
        "en": "Tractive Next",
        "de": "Tractive Next"
      },
      "link": "",
      "icon": "tractive-next.png"
    },
    "dependencies": [
      {
        "js-controller": ">=5.0.19"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=6.17.14"
      }
    ]
  },
  "native": {
    "email": "",
    "password": "",
    "interval": 60
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": "Connection",
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.lastUpdate",
      "type": "state",
      "common": {
        "name": "Last successful update",
        "type": "number",
        "role": "value.time",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "rawJson",
      "type": "state",
      "common": {
        "name": "Complete API response",
        "type": "string",
        "role": "json",
        "read": true,
        "write": false,
        "def": "{}"
      },
      "native": {}
    }
  ]
}
