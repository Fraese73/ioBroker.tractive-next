{
  "name": "iobroker.tractive-next",
  "version": "0.2.10",
  "description": "Unofficial Tractive GPS adapter for ioBroker with automatic state discovery and an admin overview tab.",
  "author": {
    "name": "Michael Fraessdorf",
    "email": "coding@michael-fr.eu"
  },
  "contributors": [
    "Michael Fraessdorf <coding@michael-fr.eu>"
  ],
  "homepage": "https://github.com/Fraese73/ioBroker.tractive-next",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "tractive",
    "gps",
    "geoposition",
    "pet",
    "tracker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fraese73/ioBroker.tractive-next.git"
  },
  "bugs": {
    "url": "https://github.com/Fraese73/ioBroker.tractive-next/issues"
  },
  "main": "build/main.js",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1",
    "axios": "^1.11.0"
  },
  "devDependencies": {
    "@iobroker/eslint-config": "^2.2.0",
    "@iobroker/testing": "^5.2.2",
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "npm run clean && tsc -p src/tsconfig.json",
    "check": "tsc -p src/tsconfig.json --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:package"
  },
  "files": [
    "admin",
    "build",
    "io-package.json",
    "README.md",
    "LICENSE"
  ]
